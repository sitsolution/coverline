# Copy to backend/.env and fill in. SECRET_KEY has no default — the app will
# refuse to start without it.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/coverline

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# In DEBUG the OTP is returned in the API response (no SMS provider yet).
# MUST be false in production.
DEBUG=true

# Comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
