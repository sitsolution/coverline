{
  "name": "locum-ops",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/web"
  ],
  "overrides": {
    "react-native-gesture-handler": "~2.20.2"
  },
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "web": "npm run dev --workspace=apps/web",
    "backend": "cd backend && python -m uvicorn app.main:app --reload"
  }
}
